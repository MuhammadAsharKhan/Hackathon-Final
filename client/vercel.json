{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hackathon-final-production-0c99.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://meet.jit.si\"), microphone=(self \"https://meet.jit.si\"), geolocation=(self), display-capture=(self \"https://meet.jit.si\")"
        }
      ]
    }
  ]
}
